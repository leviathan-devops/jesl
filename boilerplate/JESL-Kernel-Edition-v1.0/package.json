{
  "name": "@jesl/kernel",
  "version": "1.0.0",
  "type": "module",
  "description": "JESL — JSON Effect Scripting Language. A workflow engine where you define pipelines as JSON documents and execute them on the Effect-TS runtime.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-language-service patch || true"
  },
  "bin": {
    "jesl": "./cli/main.ts"
  },
  "dependencies": {
    "effect": "^3.22.1",
    "@effect/platform": "^0.84.0",
    "@effect/platform-node": "^0.108.1",
    "@effect/vitest": "^0.24.1",
    "@effect/workflow": "^0.19.1",
    "@effect/ai": "^0.37.0",
    "@effect/language-service": "^0.87.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/bun": "^1.4.0"
  }
}
